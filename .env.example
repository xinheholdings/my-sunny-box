# PostgreSQL connection string.
# Replace the placeholders with credentials from Neon, Supabase, Prisma Postgres,
# Vercel Postgres, or another PostgreSQL provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# OpenAI server-side API key.
OPENAI_API_KEY=

# Stripe Test Mode keys and recurring Price ID. Never expose these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
